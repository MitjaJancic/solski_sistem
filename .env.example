# Podatkovna baza (MariaDB)
DB_ROOT_GESLO=spremeni_me_root
DB_IME=sola_is
DB_UPORABNIK=sola_is_app
DB_GESLO=spremeni_me_app
DB_GOSTITELJ=baza
DB_VRATA=3306

# Django aplikacija
DJANGO_SECRET_KEY=spremeni-me-v-nakljucen-niz
# Razvoj: DJANGO_DEBUG=1. PRODUKCIJA (javna domena): DJANGO_DEBUG=0 (vklopi
# varnostne nastavitve: varni piškotki, HSTS ...).
DJANGO_DEBUG=1
# Razvoj: localhost,127.0.0.1. Produkcija: dodaj javno domeno, npr.
# DJANGO_ALLOWED_HOSTS=sola-is.primer.si
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Javna domena (v produkciji nastavi na dejansko domeno)
DOMENA=localhost
